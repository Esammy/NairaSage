# Linux/PaaS (Railway, Render): use rq>=2 + django-rq 4 on the server.
# Windows dev uses rq<2 + django-rq 2.x (see requirements.txt comments).
web: gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 4
worker: python manage.py rqworker high default low
scheduler: python manage.py rqscheduler
