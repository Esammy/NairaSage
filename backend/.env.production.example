# ─────────────────────────────────────────────────────────────────────────────
# NairaSage — production env for the Alibaba Cloud ECS deployment.
# Copy to backend/.env on the ECS box and fill every <...>. docker-compose reads
# this file. DATABASE_URL/REDIS_URL: web+worker use these (REDIS_URL is set by
# compose to the local redis container, so you can omit it here).
# ─────────────────────────────────────────────────────────────────────────────

DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
# 50+ random chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=<random-50+-chars>

# The DNS name you point at the ECS public IP (Caddy gets a cert for this).
# Number of trusted reverse proxies in front of the app (lets django-axes see real client IPs)
AXES_IPWARE_PROXY_COUNT=1
# Non-default admin path
ADMIN_URL=admin/
ALLOWED_HOSTS=api.nairasage.<yourdomain>
# Your deployed frontend origin(s), comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=https://<your-vercel-app>.vercel.app
CSRF_TRUSTED_ORIGINS=https://<your-vercel-app>.vercel.app

# Caddy sets X-Forwarded-Proto=https; production.py already trusts it.
SECURE_SSL_REDIRECT=True
# Skip email verification so demo accounts can sign in immediately.
REQUIRE_EMAIL_VERIFICATION=False

# ── Database ────────────────────────────────────────────────────────────────
# Default path: reuse your existing Supabase DB (the RAG corpus already lives
# there). Paste the exact DATABASE_URL from your local backend/.env.
DATABASE_URL=<your-supabase-postgres-url>
# Self-contained (localdb profile) alternative instead of the line above:
# DATABASE_URL=postgres://nairasage:nairasage@db:5432/nairasage

# ── AI: Qwen Cloud for everything, Mistral only for embeddings ──────────────
LLM_PROVIDER=qwen
DASHSCOPE_API_KEY=<sk-your-dashscope-key>
# Embedding free tier is capped + coupon not active -> embeddings on Mistral.
# Remove these two lines to move embeddings back to Qwen once paid credit works.
EMBEDDINGS_PROVIDER=mistral
MISTRAL_API_KEY=<your-mistral-key>

# ── Alibaba OSS: media storage (2nd Alibaba service, holds statement scans) ──
# IMPORTANT: use the S3-compatible endpoint with the "s3." prefix (not the plain
# oss-<region> one). OSS needs Signature V2 — production.py sets that by default.
AWS_STORAGE_BUCKET_NAME=<bucket-name>
AWS_ACCESS_KEY_ID=<ram-access-key-id>
AWS_SECRET_ACCESS_KEY=<ram-access-key-secret>
# Must match your ECS + bucket region. Free-trial ECS in US (Virginia) -> us-east-1.
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=https://s3.oss-us-east-1.aliyuncs.com
