    {
      "name": "Agent",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Coordinator chat (routes to 1–3 specialists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var j = pm.response.json();",
                  "    if (j.outcome_id) pm.environment.set('outcome_id', String(j.outcome_id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"How much did I spend on food last month? Keep it brief.\"\n}"
            },
            "url": "{{base_url}}/api/agent/chat/"
          }
        },
        {
          "name": "Coordinator chat stream (SSE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var t = pm.response.text();",
                  "    var idx = t.lastIndexOf('event: done');",
                  "    if (idx >= 0) {",
                  "        var sub = t.slice(idx);",
                  "        var m = sub.match(/data:\\s*(\\{[^}]*\\})/);",
                  "        if (m) { try { var j = JSON.parse(m[1]); if (j.outcome_id) pm.environment.set('outcome_id', String(j.outcome_id)); } catch (e) {} }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"One short tip on saving in Naira.\"\n}"
            },
            "url": "{{base_url}}/api/agent/chat/stream/"
          }
        },
