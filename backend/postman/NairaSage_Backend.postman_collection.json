          "name": "Direct — accountant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"message\": \"Summarize my spending in 2 sentences.\"\n}" },
            "url": "{{base_url}}/api/agent/accountant/"
          }
