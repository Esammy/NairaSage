{
  "info": {
    "name": "NairaSage Backend API",
    "description": "Django REST API for NairaSage.\n\n**Agents:** Twelve specialists + coordinator (includes `researcher` for Tavily-backed web context). Direct HTTP routes exist only for: accountant, investment_advisor, tax_advisor, behavioral_coach, life_planner, educator. Others (economist, opportunity_scout, debt_manager, savings_optimizer, risk_assessor, researcher) are invoked via **Agent > Coordinator chat** routing.\n\n**Coordinator streaming:** `POST /api/agent/chat/stream/` returns **SSE** (`text/event-stream`): `meta`, `delta` (token chunks), then `done` with `outcome_id`. Postman buffers the full body; browsers should use `fetch` + `ReadableStream` (not `EventSource`, which is GET-only).\n\n**Auth:** Run **Auth > Login (JWT)** first; it saves `access_token` and `refresh_token` to the active environment.\n\n**JWT:** Use `email` + `password` for login (custom user `USERNAME_FIELD`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/health/live/"
          }
        },
        {
          "name": "Readiness (DB + Redis cache)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/health/ready/"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\",\n  \"phone\": \"\"\n}"
            },
            "url": "{{base_url}}/api/auth/register/"
          }
        },
        {
          "name": "Login (JWT) — saves tokens to env",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var j = pm.response.json();",
                  "    pm.environment.set('access_token', j.access);",
                  "    pm.environment.set('refresh_token', j.refresh);",
                  "    console.log('Tokens saved to environment');",
                  "} else {",
                  "    console.log('Login failed', pm.response.code, pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/token/"
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/token/refresh/"
          }
        },
        {
          "name": "Me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/me/"
          }
        },
        {
          "name": "Patch Me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"08000000000\"\n}"
            },
            "url": "{{base_url}}/api/auth/me/"
          }
        },
        {
          "name": "User goals — list",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/goals/"
          }
        },
        {
          "name": "User goals — create",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Emergency fund\",\n  \"goal_type\": \"emergency\",\n  \"target_amount\": \"500000.00\",\n  \"current_amount\": \"0.00\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{base_url}}/api/auth/goals/"
          }
        }
      ]
    },
