DEBUG=True
SECRET_KEY=replace-with-50-char-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# DATABASE_URL=postgres://nairasage:password@localhost:5432/nairasage
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000

# mistral | qwen | openai | groq | gemini
LLM_PROVIDER=qwen

# --- Qwen Cloud (Alibaba Cloud Model Studio, OpenAI-compatible DashScope endpoint) ---
# Set LLM_PROVIDER=qwen to run the whole agent society on Qwen.
DASHSCOPE_API_KEY=
# International endpoint (default). Mainland China: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Tiered models: fast/cheap for the 12 specialists + routing, flagship for coach + synthesis.
# NOTE: use qwen-flash (non-thinking) for the fast tier — qwen3.5-flash is a
# thinking model and adds ~15s of hidden reasoning to every specialist call.
QWEN_MODEL=qwen-flash
QWEN_ROUTING_MODEL=qwen-flash
QWEN_SYNTHESIS_MODEL=qwen3-max
QWEN_COACH_MODEL=qwen3-max
# Specialists feed the synthesis step, so cap their output tightly for speed.
LLM_SPECIALIST_MAX_TOKENS=450
# Book-RAG for the 12 specialists is off by default (the coach always uses it);
# set true to also ground specialists in the Tier-1 corpus (adds an embedding call each).
SPECIALIST_TIER1_RAG=false
# Qwen-only features: vision document scan + visible-reasoning deal analysis.
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_THINKING_MODEL=qwen3-235b-a22b-thinking-2507
QWEN_EMBED_MODEL=text-embedding-v4
# Embeddings provider defaults to LLM_PROVIDER. Override it to keep chat on Qwen
# while embeddings run on Mistral (e.g. Qwen embedding free tier exhausted and no
# paid credit). After changing this, re-embed: python manage.py reembed_chunks
# EMBEDDINGS_PROVIDER=mistral
# Voice: push-to-talk transcription at POST /api/wealth/voice/transcribe/
QWEN_ASR_MODEL=qwen3-asr-flash-2026-02-10
MISTRAL_API_KEY=
# Main model for agents + synthesis (streaming uses this for final answer)
MISTRAL_MODEL=mistral-large-latest
# Faster/cheaper model for coordinator routing JSON only (strongly recommended)
MISTRAL_ROUTING_MODEL=mistral-small-latest
LLM_ROUTING_MAX_TOKENS=256
LLM_SYNTHESIS_MAX_TOKENS=2048
LLM_SYNTHESIS_TEMPERATURE=0.2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ROUTING_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ROUTING_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ROUTING_MODEL=gemini-2.0-flash

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

MONO_SECRET_KEY=
MONO_PUBLIC_KEY=
MONO_WEBHOOK_SECRET=

NGX_API_KEY=
NGX_API_URL=https://marketdataapiv3.ngxgroup.com/api
ITICK_API_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_ELITE=
PAYSTACK_CALLBACK_URL=http://localhost:3000/pricing?paid=1

FRONTEND_URL=http://localhost:3000
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

FIXER_API_KEY=

BAMBOO_API_KEY=
BAMBOO_API_URL=

RESEND_API_KEY=
DEFAULT_FROM_EMAIL=hello@nairasage.com

# S3-compatible media storage. For Alibaba Cloud OSS use the bucket's
# S3-compatible endpoint, e.g. AWS_S3_ENDPOINT_URL=https://oss-eu-central-1.aliyuncs.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=af-south-1
AWS_S3_ENDPOINT_URL=

# TLS domain for the Caddy service in docker-compose (ECS deploy)
CADDY_DOMAIN=

SENTRY_DSN=
SECURE_SSL_REDIRECT=False
SENTRY_TRACES_SAMPLE_RATE=0.1

# AssemblyAI Universal Streaming (v3): server mints short-lived tokens at GET /api/wealth/voice/token/
ASSEMBLYAI_API_KEY=
